pipeline {
    agent any
    tools{
        maven "Maven-3.9.9"
    }
    stages {
        stage('Git Clone') {
            steps {
                git branch: 'main', url: 'https://github.com/Kashi-S-A/JenkinsApp.git'
            }
        }
        stage('Maven Build') {
            steps {
                sh 'mvn clean package'
            }
        }
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t appkashi .'
            }
        }
        stage('Deployment') {
            steps {
                sh 'docker run -d -p 8085:8080 --name appkashi appkashi'
            }
        }
    }
}
